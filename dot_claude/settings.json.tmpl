{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'COMMENT RULE (global CLAUDE.md): comment the non-obvious *why*, never the *what*. Prefer clear code over a comment; delete redundant/narrating ones. Use /** ... */ for multiline. A PreToolUse hook blocks writes that add obvious violations.'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/scripts/hook-handle-use.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/scripts/hook-handle-rename.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node {{ .chezmoi.homeDir }}/.claude/hooks/comment-filter.mjs",
            "timeout": 10,
            "statusMessage": "Checking comments…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {{ .chezmoi.homeDir }}/.claude/hooks/pre-pr-comment-check.mjs",
            "if": "Bash(gh pr create*)",
            "timeout": 20,
            "statusMessage": "Checking diff for redundant comments…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {{ .chezmoi.homeDir }}/.claude/hooks/pre-pr-comment-check.mjs",
            "if": "Bash(git commit*)",
            "timeout": 20,
            "statusMessage": "Checking diff for redundant comments…"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_github_github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node {{ .chezmoi.homeDir }}/.claude/hooks/pre-pr-comment-check.mjs",
            "timeout": 20,
            "statusMessage": "Checking diff for redundant comments…"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      ".turbo/cache"
    ]
  },
  {{- /* Work plugins and marketplaces come from [data.work] in the machine-local
         chezmoi.toml, which lives outside this repo. Absent → public config only. */}}
  "enabledPlugins": {{ merge (dict
    "superpowers@claude-plugins-official" true
    "code-simplifier@claude-plugins-official" true
    "github@claude-plugins-official" true
    "frontend-design@claude-plugins-official" true
    "skill-creator@claude-plugins-official" true
    "claude-md-management@claude-plugins-official" true
    "security-guidance@claude-plugins-official" true
    "playwright@claude-plugins-official" true
    "typescript-lsp@claude-plugins-official" true
    "figma@claude-plugins-official" true
    "code-review@claude-plugins-official" true
  ) (dig "work" "plugins" dict .) | toPrettyJson | indent 2 | trim }},
  "extraKnownMarketplaces": {{ dig "work" "marketplaces" dict . | toPrettyJson | indent 2 | trim }},
  "effortLevel": "high",
  "advisorModel": "fable",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754079234298
  }
}
