[user]
  email = cdurianward@gmail.com
  name = Christopher Ward
[color]
  ui = auto
[core]
  pager = less -FMRiX
  editor = code --wait
  autocrlf = input
[push]
	default = current
	autoSetupRemote = true
[alias]
  dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
  cm = commit
  br = branch
  st = status
  sw = switch
  rs = restore
  unstage = restore --staged
  discard = restore --
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  last = log -1 HEAD
  alias = "!sh -c '[ $# = 2 ] && git config --global alias.\"$1\" \"$2\" && exit 0 || echo \"usage: git alias <new alias> <original command>\" >&2 && exit 1' -"
  aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /'
  fixup = commit --amend --no-edit
  ss = stash
  sp = stash pop
  pushf = push --force-with-lease
	gone = "!default=$(basename $(git symbolic-ref refs/remotes/origin/HEAD)); git for-each-ref --format=\"%(refname:short) %(upstream:track)\" refs/heads | while read -r b track; do [ \"$b\" = \"$default\" ] && continue; gone=0; if [ \"$track\" = \"[gone]\" ]; then gone=1; else case \"$b\" in bagelbits/*|claude/*|apex/*) git show-ref --verify --quiet \"refs/remotes/origin/$b\" || gone=1;; esac; fi; [ \"$gone\" = \"1\" ] || continue; wt=$(git worktree list --porcelain | awk -v br=\"refs/heads/$b\" \"\\$1==\\\"worktree\\\"{p=\\$2} \\$1==\\\"branch\\\" && \\$2==br{print p}\"); if [ -n \"$wt\" ]; then git worktree remove \"$wt\" || { echo \"gone: skipping worktree removal for $wt (has local changes) -- remove manually or with --force\" >&2; continue; }; fi; if git branch -d \"$b\" 2>/dev/null; then :; else mb=$(git merge-base \"origin/$default\" \"$b\" 2>/dev/null); tree=$(git rev-parse \"$b^{tree}\" 2>/dev/null); if [ -n \"$mb\" ] && dc=$(git commit-tree \"$tree\" -p \"$mb\" -m _ 2>/dev/null) && git cherry \"origin/$default\" \"$dc\" 2>/dev/null | grep -q \"^-\"; then git branch -D \"$b\" && echo \"gone: $b squash-merged -- deleted\" >&2; else echo \"gone: $b not fully merged -- keeping (git branch -D $b to force)\" >&2; fi; fi; done; git worktree prune"
  nbr = "!f() { git checkout -b bagelbits.$1; }; f"
	brc = "!f() { default=$(basename $(git symbolic-ref refs/remotes/origin/HEAD)); branch=${1:-$default}; current=$(git branch --show-current); if [ \"$branch\" != \"$current\" ]; then wt=$(git worktree list --porcelain | awk -v b=\"refs/heads/$branch\" \"\\$1==\\\"worktree\\\"{p=\\$2} \\$1==\\\"branch\\\" && \\$2==b{print p}\"); fi; if [ -n \"$wt\" ]; then (unset GIT_DIR GIT_WORK_TREE; cd \"$wt\" && git pull); else git switch \"$branch\" && git pull; fi; git gone; }; f"
[difftool "sourcetree"]
  cmd = opendiff \"$LOCAL\" \"$REMOTE\"
  path =
[mergetool "sourcetree"]
  cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
  trustExitCode = true
[fetch]
  prune = true
[remote "origin"]
  prune = true
[credential]
	helper = osxkeychain
[pull]
	rebase = merges
[diff]
	colorMoved = zebra
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[rebase]
	autoStash = true
	autoSquash = true
[help]
	autocorrect = prompt
[init]
	defaultBranch = main
[rerere]
	enabled = true
[include]
	path = ~/.gitconfig.local
